table audit
	lineageTag: 063120fd-0c03-4721-bf38-90f02c788c5d

	measure 'Total audits' = COUNTROWS(audit)
		formatString: 0
		lineageTag: 7134da4e-c051-4065-8ae6-243a350819b6

	measure 'Upcoming audits in 30 days' =
			
			var duecount=COUNTROWS(
			    FILTER(
			        audit,audit[Days till Scheduled Audit]>0
			    && audit[Days till Scheduled Audit]<=30
			    )
			    )
			    return
			    duecount
		formatString: 0
		lineageTag: 5400b2ad-0a90-4c5a-887e-19549d94298f

	measure 'Upcoming audits in 60 days' =
			
			var duecount=COUNTROWS(
			    FILTER(
			        audit,audit[Days till Scheduled Audit]>30
			    && audit[Days till Scheduled Audit]<=60
			    )
			    )
			    return
			    duecount
		formatString: 0
		lineageTag: 5414b335-d0d1-46d3-b340-d2b1a211acd5

	measure 'Upcoming audits in 90 days' =
			
			var duecount=COUNTROWS(
			    FILTER(
			        audit,audit[Days till Scheduled Audit]>60
			    && audit[Days till Scheduled Audit]<=90
			    )
			    )
			    return
			    duecount
		formatString: 0
		lineageTag: 55efeda1-7a40-4d38-8527-6d5a1239fbcb

	measure 'Internal Audit' =
			
			COUNTAX(FILTER(audit,audit[is_internal_audit]=TRUE()),TRUE()
			
			)
		formatString: 0
		lineageTag: b1c2c62d-21e8-4270-8895-91a0c9814559

	measure 'External Audit' =
			
			COUNTAX(FILTER(audit,audit[is_internal_audit]=FALSE()),FALSE()
			)
		formatString: 0
		lineageTag: 495e38ce-4870-4eda-bc2e-e07bf0586987

