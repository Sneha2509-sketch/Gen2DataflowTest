	column 'Days till Scheduled Audit' =
			
			var due=DATEDIFF(TODAY(),audit[date_audit_scheduled],DAY)
			return
			if (due<=0,BLANK(),due)
		formatString: 0
		lineageTag: 7985ef2c-bbb9-4d9f-9173-82910d2c92be
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

