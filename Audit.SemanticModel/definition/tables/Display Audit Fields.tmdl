	partition 'Display Audit Fields' = calculated
		mode: import
		source = ```
				{
				     ("Audit Type",NAMEOF(audit_type[Audit type]),1),
				    ("Date audit canceled", NAMEOF('audit'[date_audit_canceled]), 2),
				    ("Date audit completed", NAMEOF('audit'[date_audit_completed]), 3),
				    ("Date audit scheduled", NAMEOF('audit'[date_audit_scheduled]), 4),
				    ("Date audit scheduled end", NAMEOF('audit'[date_audit_scheduled_end]), 5),
				    ("Date created", NAMEOF('audit'[date_created]), 6),
				    ("Days till Scheduled Audit", NAMEOF('audit'[Days till Scheduled Audit]), 7),
				    ("Id", NAMEOF('audit'[id]), 8),
				    ("Impacts accreditiation", NAMEOF('audit'[impacts_accreditiation]), 9),
				    ("Is internal audit", NAMEOF('audit'[is_internal_audit]), 10) 
				}
