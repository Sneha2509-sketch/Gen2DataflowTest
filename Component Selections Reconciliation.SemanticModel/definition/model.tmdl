model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Functions

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Main Queries'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Metadata Queries'

	annotation PBI_QueryGroupOrder = 2

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 3

queryGroup 'UUID Tables'

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Workspace_UUID","Dataflow_UUID","getDataflowUUID","environment","Version","workspace","getWorkspaceUUID","ToLocal","Reports Withdrawn","ReportTransfers","CSR_DBName","CSR_DF_LastUpdated","CSR_DF_Version","Report Version"]

annotation PBI_ProTooling = ["DevMode"]

ref table Workspace_UUID
ref table Dataflow_UUID
ref table 'Reports Withdrawn'
ref table ReportTransfers
ref table CSR_DBName
ref table CSR_DF_LastUpdated
ref table CSR_DF_Version
ref table 'Report Version'

ref cultureInfo en-US

