expression ToLocal =
		(theDate as datetimezone) =>
		let
		    newDate = DateTimeZone.SwitchZone(theDate, 4),
		    returnDate = DateTimeZone.RemoveZone(newDate)
		in
		    returnDate as datetime
	lineageTag: 6d505ca5-40a8-4cd1-9c1c-a96e97096ea6
	queryGroup: Functions

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

